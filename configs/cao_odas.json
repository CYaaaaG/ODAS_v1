  "pseudo_label_weight": 0.9,
  "ema_decay": 0.999,
  "ast_beta": 2.0,
  "memory_size": 1024,
  "memory_temperature": 0.07,
  "lambda_s": 1.0,
  "lambda_uc": 1.0,
  "lambda_u": 1.0,
  "lambda_c": 1.0,
  "lambda_f": 1.0,
  "lambda_e": 1.2,
  "device": "cuda",
  "num_workers": 0,
  "output_dir": "runs/cao_odas",
